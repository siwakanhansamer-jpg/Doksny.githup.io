<div id="view-login" class="view-section">
    <header>
        <div class="logo-container" onclick="switchView('visitor')">
            <div class="logo">สกร.</div>
            <h2 class="dynamic-school-name">โรงเรียนบ้านกรูดหนองซำ</h2>
        </div>
        <button class="btn-action view-site" style="margin-right:40px;" onclick="switchView('visitor')">🏠 กลับหน้าหลัก</button>
