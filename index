        <p>&copy; 2026 สงวนลิขสิทธิ์</p>
    </footer>
</div>

<div id="news-reader-modal" class="custom-modal" onclick="closeNewsModal(event)">
    <div class="modal-content-box">
        <span class="close-modal-x" onclick="document.getElementById('news-reader-modal').style.display='none'">&times;</span>
        <div class="modal-inner-body">
            <div id="modal-image-area"></div>
            <h2 id="modal-news-title">หัวข้อข่าวกิจกรรม</h2>
            <p id="modal-news-desc">เนื้อหาและรายละเอียดแบบเต็ม</p>
        </div>
