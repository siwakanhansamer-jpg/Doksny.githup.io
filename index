            <button class="btn-submit" style="margin-top:15px;" onclick="handleLogin()">ยืนยันเข้าสู่ระบบ</button>
        </div>
    </div>
</div>


<div id="view-admin" class="view-section">
    <div class="admin-layout">
        <div class="admin-sidebar">
            <h3>Nonsang Admin Panel</h3>
            <ul class="admin-menu-list">
                <li class="active" onclick="switchAdminTab('news')">📢 จัดการข่าวสาร</li>
                <li onclick="switchAdminTab('info')">🏫 ข้อมูลโรงเรียน & ผู้บริหาร</li>
            </ul>
            <div style="position:absolute; bottom:20px; width:220px;">
                <button class="btn-submit" style="background-color:var(--danger-color);" onclick="handleLogout()">Logout ออกจากระบบ</button>
            </div>
        </div>

        <div class="admin-main">
            <div class="admin-header">
                <h2>ระบบบริหารจัดการเนื้อหาเว็บไซต์</h2>
                <button class="btn-action view-site" onclick="switchView('visitor')">👁️ ดูหน้าเว็บจริง</button>
            </div>

            <div id="admin-tab-news" class="admin-tab-content">
                <div class="admin-panel-card">
                    <h3>รายการข่าวประชาสัมพันธ์ปัจจุบัน (เพิ่มได้ไม่จำกัด)</h3>
                    <button class="btn-action add" onclick="openNewsForm(-1)">➕ เพิ่มข่าวประชาสัมพันธ์ใหม่</button>
                    
                    <div id="news-form-block" class="news-form-container" style="display:none;">
                        <h4 id="form-action-title" style="margin-top:0; color:var(--primary-color);">เพิ่มข้อมูลข่าวสาร</h4>
                        <input type="hidden" id="edit-news-index" value="-1">
                        
                        <div class="form-group">
                            <label>ชื่อกิจกรรม / หัวข้อข่าวสาร</label>
                            <input type="text" id="news-title-input" placeholder="ระบุชื่อกิจกรรมหลักที่นี่">
                        </div>
                        
                        <div class="form-group">
                            <label>ข้อความรายละเอียดกิจกรรม</label>
                            <textarea id="news-desc-input" rows="4" placeholder="ระบุรายละเอียดโครงการ วัน เวลา สถานที่ หรือเนื้อหาข่าวประชาสัมพันธ์"></textarea>
                        </div>
                        
                        <div class="form-group">
                            <label>รูปภาพประกอบกิจกรรม</label>
                            <input type="file" id="news-img-input" accept="image/*" onchange="processAndPreviewImage(event, 'news')">
                            <div style="margin-top: 10px;">
                                <img id="news-img-preview" src="" style="max-width:240px; display:none; border-radius:6px; border:1px solid #ddd;">
                            </div>
                        </div>
                        
                        <div style="margin-top:20px;">
                            <button class="btn-action add" style="margin-bottom:0;" onclick="saveNewsItem()">💾 บันทึกข้อมูลข่าว</button>
                            <button class="btn-action cancel" onclick="closeNewsForm()">ยกเลิก</button>
                        </div>
                    </div>

                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th style="width: 20%;">รูปภาพ</th>
                                <th style="width: 55%;">หัวข้อและรายละเอียด</th>
                                <th style="width: 25%; text-align: center;">เครื่องมือจัดการ</th>
                            </tr>
                        </thead>
                        <tbody id="admin-news-table-body">
                            </tbody>
                    </table>
                </div>
            </div>

            <div id="admin-tab-info" class="admin-tab-content" style="display:none;">
                <div class="admin-panel-card">
                    <h3>แก้ไขเนื้อหาข้อมูลหน้าแรก</h3>
                    <div class="form-group">
                        <label>ชื่อสถานศึกษา/หัวข้อเว็บ</label>
                        <input type="text" id="edit-school-name">
                    </div>
                    <div class="form-group">
                        <label>หัวข้อใหญ่แบนเนอร์ (Hero Title)</label>
                        <input type="text" id="edit-hero-title">
                    </div>
                    <div class="form-group">
                        <label>คำอธิบายแบนเนอร์ (Hero Description)</label>
                        <input type="text" id="edit-hero-desc">
                    </div>
                    <div class="form-group">
                        <label>คำแนะนำหน้า ITA</label>
                        <input type="text" id="edit-ita-intro">
                    </div>
                    
                    <hr style="margin: 30px 0; border: 0; border-top: 1px solid #cbd5e1;">
                    
                    <h3>👑 ข้อมูลและรูปภาพผู้บริหาร</h3>
                    <div class="form-group">
                        <label>ชื่อ-นามสกุล ผู้บริหาร</label>
                        <input type="text" id="edit-dir-name" placeholder="ตัวอย่าง: นายสมชาย ใจดี">
                    </div>
                    <div class="form-group">
                        <label>ตำแหน่ง</label>
                        <input type="text" id="edit-dir-pos" placeholder="ตัวอย่าง: ผู้อำนวยการโรงเรียน">
                    </div>
                    <div class="form-group">
                        <label>อัปโหลดรูปภาพประจำตัวผู้บริหาร</label>
                        <input type="file" id="edit-dir-img-input" accept="image/*" onchange="processAndPreviewImage(event, 'director')">
                        <div style="margin-top: 15px;">
                            <img id="edit-dir-img-preview" src="" style="width:120px; height:150px; object-fit:cover; display:none; border-radius:6px; border:2px solid #cbd5e1;">
                        </div>
                    </div>
                    
                    <div style="margin-top: 25px;">
                        <button class="btn-submit" style="background-color:var(--success-color); width: auto; padding: 12px 30px;" onclick="saveSchoolInfo()">💾 บันทึกข้อมูลทั้งหมด</button>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<script>
    // รูปภาพ Default จำลองสำหรับกิจกรรมแรกสุด
    const defaultPlaceholderImg = "https://images.unsplash.com/photo-1577896851231-70ef18881754?auto=format&fit=crop&q=80&w=600";

    // ข้อมูลเริ่มต้นระบบข่าวสาร
    const initialNews = [
        {
            title: "โครงการศูนย์ฝึกอาชีพชุมชน 10 ตำบล ประจำอำเภอโนนสัง",
            desc: "สกร.ระดับอำเภอโนนสัง เดินหน้าจัดกิจกรรมอบรมอาชีพระยะสั้น มุ่งเน้นการฝึกทักษะที่ตรงกับความต้องการของพื้นที่ เพื่อยกระดับคุณภาพชีวิตและเพิ่มรายได้ให้แก่ประชาชนอย่างยั่งยืน",
            img: defaultPlaceholderImg
        },
        {
            title: "ประกาศรับสมัครนักเรียนใหม่ ประจำปีการศึกษา 2569",
            desc: "โรงเรียนบ้านกรูดหนองซำเปิดรับสมัครนักเรียนเข้าศึกษาต่อในระดับชั้นต่างๆ ประจำปีการศึกษาใหม่ ผู้ปกครองที่สนใจสามารถติดต่อขอรับเอกสารได้ที่ห้องธุรการ",
            img: ""
        }
    ];

    // ข้อมูลข้อความเริ่มต้นระบบ
    const initialTextConfig = {
        schoolName: "โรงเรียนบ้านกรูดหนองซำ",
        heroTitle: "ยินดีต้อนรับสู่เว็บไซต์",
        heroDesc: "โรงเรียนบ้านกรูดหนองซำ สังกัดสำนักงานเขตพื้นที่การศึกษาประถมศึกษา มุ่งมั่นพัฒนาผู้เรียนสู่ความเป็นเลิศ ควบคู่คุณธรรม",
        itaIntro: "การเปิดเผยข้อมูลสาธารณะ (Open Data Integrity and Transparency Assessment: OIT) เพื่อยกระดับความโปร่งใสของหน่วยงาน",
        dirName: "นายสมชาย ใจดี",
        dirPos: "ผู้อำนวยการโรงเรียน\nโรงเรียนบ้านกรูดหนองซำ",
        dirImg: "" 
    };

    let uploadedImageBase64 = "";
    let uploadedDirImageBase64 = "";

    window.onload = function() {
        initLocalStorage();
        updateUIElements();
        
        if (sessionStorage.getItem('admin_session') === 'active') {
            switchView('admin');
        }
    };

    function initLocalStorage() {
        if (!localStorage.getItem('news_data')) {
            localStorage.setItem('news_data', JSON.stringify(initialNews));
        }
        if (!localStorage.getItem('text_config')) {
            localStorage.setItem('text_config', JSON.stringify(initialTextConfig));
        }
    }

    // ฟังก์ชันอัปเดตข้อมูลบนหน้าจอทั้งหมด
    function updateUIElements() {
        const news = JSON.parse(localStorage.getItem('news_data')) || [];
        const config = JSON.parse(localStorage.getItem('text_config'));

        // เรียงจากข่าวใหม่ล่าสุดไปเก่าสุด (เอาข่าวกิจกรรมใหม่โชว์ก่อน)
        const sortedNews = [...news].reverse();

        // 1. อัปเดตข่าวสารในหน้าผู้เยี่ยมชม (Visitor View) - จำกัดแสดงไม่เกิน 5 ข่าวล่าสุด
        const publicList = document.getElementById('public-news-list');
        publicList.innerHTML = '';
        
        const homepageNews = sortedNews.slice(0, 5);
        homepageNews.forEach(item => {
            const actualIndex = news.indexOf(item); // หาอินเด็กซ์จริงใน LocalStorage
            const card = createNewsCardElement(item, actualIndex);
            publicList.appendChild(card);
        });

        // จัดการแสดงผลปุ่ม "กิจกรรมอื่น ๆ"
        const moreBtnContainer = document.getElementById('more-activities-container');
        moreBtnContainer.innerHTML = '';
        if (news.length > 5) {
            const moreBtn = document.createElement('button');
            moreBtn.className = 'more-activities-btn';
            moreBtn.innerHTML = '📂 ดู กิจกรรมอื่น ๆ ทั้งหมด';
            moreBtn.onclick = () => switchView('activities');
            moreBtnContainer.appendChild(moreBtn);
        }

        // 1.5 อัปเดตในหน้าศูนย์รวมกิจกรรมทั้งหมด (All Activities View) - แสดงครบทุกข่าวไม่จำกัด
        const allActivitiesList = document.getElementById('all-activities-news-list');
        allActivitiesList.innerHTML = '';
        sortedNews.forEach(item => {
            const actualIndex = news.indexOf(item);
            const card = createNewsCardElement(item, actualIndex);
            allActivitiesList.appendChild(card);
        });

        // 2. อัปเดตรูปภาพและข้อมูลผู้บริหาร
        const dirImgContainer = document.getElementById('dynamic-dir-img-container');
        if (config.dirImg) {
            dirImgContainer.innerHTML = `<img src="${config.dirImg}" class="director-img" alt="รูปภาพผู้บริหาร">`;
        } else {
            dirImgContainer.innerHTML = `<div class="director-img">รูปภาพ</div>`;
        }

        document.querySelectorAll('.dynamic-school-name').forEach(el => el.innerText = config.schoolName);
        document.querySelector('.dynamic-hero-title').innerText = config.heroTitle;
        document.querySelector('.dynamic-hero-desc').innerText = config.heroDesc;
        document.querySelector('.dynamic-ita-intro').innerText = config.itaIntro;
        document.querySelector('.dynamic-dir-name').innerText = config.dirName;
        document.querySelector('.dynamic-dir-pos').innerHTML = config.dirPos.replace(/\n/g, '<br>');

        // 3. ใส่ข้อมูลเดิมเข้าฟอร์มในหน้าหลังบ้าน
        document.getElementById('edit-school-name').value = config.schoolName;
        document.getElementById('edit-hero-title').value = config.heroTitle;
        document.getElementById('edit-hero-desc').value = config.heroDesc;
        document.getElementById('edit-ita-intro').value = config.itaIntro;
        document.getElementById('edit-dir-name').value = config.dirName;
        document.getElementById('edit-dir-pos').value = config.dirPos;
        
        const dirPreview = document.getElementById('edit-dir-img-preview');
        if (config.dirImg) {
            dirPreview.src = config.dirImg;
            dirPreview.style.display = 'block';
            uploadedDirImageBase64 = config.dirImg; 
        } else {
            dirPreview.style.display = 'none';
            dirPreview.src = '';
            uploadedDirImageBase64 = '';
        }

        // 4. วาดตารางจัดการข่าวสารหลังบ้านแอดมิน (แสดงครบทั้งหมดเพื่อให้ลบ/แก้ไขได้ง่าย)
        const adminNewsBody = document.getElementById('admin-news-table-body');
        adminNewsBody.innerHTML = '';
        
        news.forEach((item, index) => {
            const tr = document.createElement('tr');
            const thumbImg = item.img 
                ? `<img src="${item.img}" style="width:90px; height:60px; object-fit:cover; border-radius:4px; border:1px solid #ccc;">`
                : `<div style="width:90px; height:60px; background:#cbd5e1; border-radius:4px; font-size:11px; display:flex; align-items:center; justify-content:center; color:#475569;">No Image</div>`;

            tr.innerHTML = `
                <td style="vertical-align:top;">${thumbImg}</td>
                <td>
                    <strong style="color:var(--primary-color); font-size:15px;">${item.title}</strong>
                    <div style="font-size:13px; color:#555; margin-top:5px; max-height:40px; overflow:hidden; text-overflow:ellipsis; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical;">${item.desc || ''}</div>
                </td>
                <td style="text-align:center; vertical-align:middle;">
                    <button class="btn-action edit" onclick="openNewsForm(${index})">แก้ไข</button>
                    <button class="btn-action delete" onclick="deleteNewsItem(${index})">ลบ</button>
                </td>
            `;
            adminNewsBody.appendChild(tr);
        });
    }

    // ฟังก์ชันช่วยสร้าง HTML Card ของข่าวสาร รองรับระบบคลิกเปิดอ่าน Modal เต็มหน้าจอ
    function createNewsCardElement(item, actualIndex) {
        const card = document.createElement('div');
        card.className = 'news-item-card';
        card.onclick = () => openNewsReaderModal(actualIndex);
        
        const imgTag = item.img 
            ? `<img src="${item.img}" class="news-card-img" alt="ภาพกิจกรรม">` 
            : `<div class="news-card-img" style="display:flex;align-items:center;justify-content:center;color:#888;font-size:12px;background:#e2e8f0;flex-shrink:0;">ไม่มีภาพประกอบ</div>`;

        card.innerHTML = `
            ${imgTag}
            <div class="news-card-content">
                <h3>${item.title}</h3>
                <p>${item.desc ? item.desc : 'ไม่มีรายละเอียดข้อความเพิ่มเติม'}</p>
            </div>
        `;
        return card;
    }

    // ฟังก์ชันเปิด Pop-up Modal อ่านข่าวสารฉบับเต็มและดูรูปขนาดใหญ่
    function openNewsReaderModal(index) {
        const news = JSON.parse(localStorage.getItem('news_data')) || [];
        const selected = news[index];
        if (!selected) return;

        document.getElementById('modal-news-title').innerText = selected.title;
        document.getElementById('modal-news-desc').innerText = selected.desc || 'ไม่มีรายละเอียดข้อความเพิ่มเติม';
        
        const imageArea = document.getElementById('modal-image-area');
        if (selected.img) {
            imageArea.innerHTML = `<img src="${selected.img}" class="modal-full-img" alt="รูปภาพกิจกรรมเต็มจอ">`;
        } else {
            imageArea.innerHTML = ''; 
        }

        document.getElementById('news-reader-modal').style.display = 'flex';
    }

    // ฟังก์ชันปิด Modal เมื่อคลิกด้านนอกกล่องสีขาว
    function closeNewsModal(event) {
        if (event.target.id === 'news-reader-modal') {
            document.getElementById('news-reader-modal').style.display = 'none';
        }
    }

    /* ======================================================== */
    /* ฟังก์ชันเด่น: บีบอัดและลดขนาดภาพเพื่อประหยัดพื้นที่คลังข้อมูล (Fix Bug)  */
    /* ======================================================== */
    function processAndPreviewImage(event, type) {
        const file = event.target.files[0];
        if (!file) return;

        const reader = new FileReader();
        reader.onload = function(e) {
            const img = new Image();
            img.onload = function() {
                // คำนวณอัตราส่วนเพื่อย่อขนาดให้ความกว้างสูงสุดไม่เกิน 800px (ขนาดกำลังคมชัดและไฟล์เล็กมาก)
                const maxWidth = 800;
                let width = img.width;
                let height = img.height;

                if (width > maxWidth) {
                    height = Math.round((height * maxWidth) / width);
                    width = maxWidth;
                }

                // สั่งวาดรูปลง HTML5 Canvas เพื่อทำการแปลงและลด Quality % ลง
                const canvas = document.createElement('canvas');
                canvas.width = width;
                canvas.height = height;
                const ctx = canvas.getContext('2d');
                ctx.drawImage(img, 0, 0, width, height);

                // บีบอัดภาพให้ออกมาเป็น JPEG ที่ระดับคุณภาพ 75%
                const compressedBase64 = canvas.toDataURL('image/jpeg', 0.75);

                if (type === 'news') {
                    uploadedImageBase64 = compressedBase64;
                    const previewImg = document.getElementById('news-img-preview');
                    previewImg.src = compressedBase64;
                    previewImg.style.display = "block";
                } else if (type === 'director') {
                    uploadedDirImageBase64 = compressedBase64;
                    const previewImg = document.getElementById('edit-dir-img-preview');
                    previewImg.src = compressedBase64;
                    previewImg.style.display = "block";
                }
            };
            img.src = e.target.result;
        };
        reader.readAsDataURL(file);
    }

    // แอดมิน: บันทึกข้อมูลโรงเรียนและผู้บริหาร
    function saveSchoolInfo() {
        const updatedConfig = {
            schoolName: document.getElementById('edit-school-name').value.trim(),
            heroTitle: document.getElementById('edit-hero-title').value.trim(),
            heroDesc: document.getElementById('edit-hero-desc').value.trim(),
            itaIntro: document.getElementById('edit-ita-intro').value.trim(),
            dirName: document.getElementById('edit-dir-name').value.trim(),
            dirPos: document.getElementById('edit-dir-pos').value.trim(),
            dirImg: uploadedDirImageBase64 
        };

        localStorage.setItem('text_config', JSON.stringify(updatedConfig));
        updateUIElements();
        document.getElementById('edit-dir-img-input').value = "";
        alert("💾 บันทึกข้อมูลสถานศึกษาและโปรไฟล์ผู้บริหารเรียบร้อยแล้ว!");
    }

    function openNewsForm(index) {
        document.getElementById('news-form-block').style.display = 'block';
        document.getElementById('edit-news-index').value = index;
        document.getElementById('news-img-input').value = "";

        if (index === -1) {
            document.getElementById('form-action-title').innerText = "➕ เพิ่มข่าวประชาสัมพันธ์ใหม่";
            document.getElementById('news-title-input').value = "";
            document.getElementById('news-desc-input').value = "";
            document.getElementById('news-img-preview').style.display = "none";
            document.getElementById('news-img-preview').src = "";
            uploadedImageBase64 = "";
        } else {
            document.getElementById('form-action-title').innerText = "📝 แก้ไขข้อมูลข่าวประชาสัมพันธ์";
            const news = JSON.parse(localStorage.getItem('news_data'));
            const currentItem = news[index];
            
            document.getElementById('news-title-input').value = currentItem.title;
            document.getElementById('news-desc-input').value = currentItem.desc || "";
            
            if (currentItem.img) {
                document.getElementById('news-img-preview').src = currentItem.img;
                document.getElementById('news-img-preview').style.display = "block";
                uploadedImageBase64 = currentItem.img;
            } else {
                document.getElementById('news-img-preview').style.display = "none";
                document.getElementById('news-img-preview').src = "";
                uploadedImageBase64 = "";
            }
        }
        document.getElementById('news-form-block').scrollIntoView({ behavior: 'smooth' });
    }

    function closeNewsForm() {
        document.getElementById('news-form-block').style.display = 'none';
        uploadedImageBase64 = "";
    }

    function saveNewsItem() {
        const titleText = document.getElementById('news-title-input').value.trim();
        const descText = document.getElementById('news-desc-input').value.trim();
        const currentIndex = parseInt(document.getElementById('edit-news-index').value);

        if (titleText === "") {
            alert("⚠️ กรุณากรอกหัวข้อข่าวสารก่อนบันทึกครับ");
            return;
        }

        const news = JSON.parse(localStorage.getItem('news_data')) || [];
        const newsObject = { title: titleText, desc: descText, img: uploadedImageBase64 };

        if (currentIndex === -1) {
            news.push(newsObject);
        } else {
            news[currentIndex] = newsObject;
        }

        try {
            localStorage.setItem('news_data', JSON.stringify(news));
            updateUIElements();
            closeNewsForm();
            alert("💾 บันทึกข้อมูลข่าวสารเรียบร้อยแล้ว!");
        } catch (error) {
            alert("❌ ไม่สามารถบันทึกได้เนื่องจากขนาดไฟล์รูปภาพอาจมีขนาดใหญ่เกินความจุจำลองที่เครื่องรับไหว กรุณาลองเลือกรูปภาพอื่นที่มีรายละเอียดน้อยลง หรือลบข่าวประชาสัมพันธ์เก่าๆ บางข่าวออกก่อนครับ");
        }
    }

    function deleteNewsItem(index) {
        if (confirm("คุณแน่ใจหรือไม่ว่าต้องการลบข่าวประชาสัมพันธ์หัวข้อนี้?")) {
            const news = JSON.parse(localStorage.getItem('news_data'));
            news.splice(index, 1);
            localStorage.setItem('news_data', JSON.stringify(news));
            updateUIElements();
            closeNewsForm();
        }
    }

    function switchView(viewName) {
        document.querySelectorAll('.view-section').forEach(sec => sec.classList.remove('active'));
        document.getElementById('view-' + viewName).classList.add('active');
        
        if (viewName === 'admin' && sessionStorage.getItem('admin_session') !== 'active') {
            switchView('login');
        }
        window.scrollTo({top: 0, behavior: 'smooth'});
    }

    function switchAdminTab(tabName) {
        document.querySelectorAll('.admin-tab-content').forEach(content => content.style.display = 'none');
        document.querySelectorAll('.admin-menu-list li').forEach(li => li.classList.remove('active'));
        
        document.getElementById('admin-tab-' + tabName).style.display = 'block';
        event.currentTarget.classList.add('active');
        closeNewsForm();
    }

    function handleLogin() {
        const user = document.getElementById('input-username').value;
        const pass = document.getElementById('input-password').value;
        const errorMsg = document.getElementById('login-error-msg');

        if (user === 'nonsang' && pass === 'nonsang100') {
            sessionStorage.setItem('admin_session', 'active');
            errorMsg.style.display = 'none';
            document.getElementById('input-username').value = '';
            document.getElementById('input-password').value = '';
            switchView('admin');
        } else {
            errorMsg.style.display = 'block';
        }
    }

    function handleLogout() {
        sessionStorage.removeItem('admin_session');
        switchView('visitor');
    }
</script>

</body>
</html>
